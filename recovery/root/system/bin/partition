#!/sbin/bash
. common
disk=/dev/block/sda
max=$(($(blockdev --getsize64 $disk) / 1000000))
[ -z "$max" ] && { echo "Failed to get disk size"; exit 1; }
RES_START=12505 RES_END=8000
winmax=$(( (max - RES_START - RES_END)/1000 ))

if [ -n "$1" ]; then
    s="$1"
else
    echo -n -e "\nEnter Windows size GB (30-$winmax): "
    read s
    if [ -z "$s" ]; then
        echo -e "Please enter a valid size in GB.\n"
        exit 1
    fi
fi
s=$(echo "$s" | tr -cd '0-9.')

case $s in *.*) i=${s%.*}; f=${s#*.}; pow=1; for j in $(seq 1 ${#f}); do pow=$((pow*10)); done
  mb=$((i*1000 + f*1000/pow)) ;; *) mb=$((s*1000)) ;; esac

[ $mb -lt 30000 ] || [ $mb -gt $((winmax*1000)) ] && { echo -n -e "\nSize should be between (30-$winmax)\n"; exit 1; }

winend=$(( mb + RES_START ))
echo -e "\nWindows: $(( (winend-RES_START)/1000 )) GB\nAndroid: $(( (max-winend)/1000 )) GB\n"
echo -n "Does this sound good (y/n)? "; read yn
case "$yn" in [Yy]*) ;; *) echo -e "lol ! Rethink carefully.\n"; exit 1;; esac

echo -e "\n=== Partitioning ==="
for i in 33 34 35 36 37; do parted -s $disk rm $i 2>/dev/null; done
sgdisk --resize-table 64 $disk
parted -s $disk \
    mkpart esp fat32 12155MB 12505MB \
    mkpart win ntfs 12505MB ${winend}MB \
    mkpart userdata ext4 ${winend}MB 100% \
    set 33 esp on
sync

echo -e "\n=== Formatting ==="
mkfs.fat -F32 -s1 ${disk}33 -n ESPLISA
mkfs.ntfs -f ${disk}34 -L WINLISA
make_f2fs -f -g android ${disk}35
mke2fs -t ext4 -F /dev/block/by-name/metadata

fixgpt
parted $disk p free
echo "done!"
